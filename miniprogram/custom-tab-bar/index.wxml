<view class="tab-shell" data-b="B100">
  <view wx:for="{{list}}" wx:key="path" class="tab-item {{index === selected ? 'active' : ''}}" data-index="{{index}}" data-z="Z100-1" bindtap="switchTab">
    <text class="tab-icon {{index === 2 ? 'publish-icon' : ''}}">{{item.icon}}</text>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
<dev-badge wx:if="{{developerMode}}" class="tab-code" code="B100" />
