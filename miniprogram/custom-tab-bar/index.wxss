.tab-shell { height: 112rpx; padding-bottom: env(safe-area-inset-bottom); display: flex; align-items: center; justify-content: space-around; background: #fff; border-top: 1rpx solid #e7ede7; box-shadow: 0 -8rpx 30rpx rgba(24,53,40,.04); }
.tab-item { width: 20%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #6e8178; font-size: 21rpx; gap: 2rpx; }
.tab-item.active { color: #236e53; font-weight: 600; }
.tab-icon { height: 48rpx; line-height: 48rpx; font-size: 42rpx; }
.publish-icon { width: 78rpx; height: 78rpx; line-height: 70rpx; text-align: center; background: #f5ce4b; border-radius: 28rpx; color: #172c26; font-size: 60rpx; font-weight: 500; margin-top: -32rpx; box-shadow: 0 8rpx 18rpx rgba(172,130,22,.2); }
