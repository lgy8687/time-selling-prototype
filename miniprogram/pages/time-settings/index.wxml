<view class="page" data-b="B223">
  <dev-badge wx:if="{{developerMode}}" code="B223" />
  <view class="title">时间块设置</view>
  <view class="card" data-b="B703">
    <dev-badge wx:if="{{developerMode}}" code="B703" />
    <view class="section-title">显示时间</view>
    <view class="time-fields">
      <picker mode="selector" range="{{hoursStart}}" value="{{settings.startHour}}" data-key="startHour" data-z="Z703-1" bindchange="setHour"><view class="picker">{{settings.startHour}}:00 开始</view></picker>
      <picker mode="selector" range="{{hoursEnd}}" value="{{settings.endHour - 1}}" data-key="endHour" data-z="Z703-2" bindchange="setHour"><view class="picker">{{settings.endHour}}:00 结束</view></picker>
    </view>
    <view class="field-label">一小时分格</view>
    <view class="mode-list">
      <view class="{{settings.mode === 2 ? 'chosen' : ''}}" data-mode="2" data-z="Z703-3" bindtap="setMode">2 格 · 30＋30 分钟</view>
      <view class="{{settings.mode === 3 ? 'chosen' : ''}}" data-mode="3" data-z="Z703-4" bindtap="setMode">3 格 · 30＋15＋15 分钟</view>
      <view class="{{settings.mode === 4 ? 'chosen' : ''}}" data-mode="4" data-z="Z703-5" bindtap="setMode">4 格 · 每格 15 分钟</view>
    </view>
    <view class="field-label">时间块字号</view>
    <view class="choice-row">
      <text class="{{!settings.blockFontSize ? 'chosen' : ''}}" data-size="0" data-z="Z703-6" bindtap="setFontSize">小</text>
      <text class="{{settings.blockFontSize === 1 ? 'chosen' : ''}}" data-size="1" data-z="Z703-7" bindtap="setFontSize">中</text>
      <text class="{{settings.blockFontSize === 2 ? 'chosen' : ''}}" data-size="2" data-z="Z703-8" bindtap="setFontSize">大</text>
    </view>
    <view class="field-label">右侧标签显示</view>
    <view class="choice-row">
      <text class="{{settings.labelLevel !== 2 ? 'chosen' : ''}}" data-level="1" data-z="Z703-9" bindtap="setLabelLevel">一级标签</text>
      <text class="{{settings.labelLevel === 2 ? 'chosen' : ''}}" data-level="2" data-z="Z703-10" bindtap="setLabelLevel">二级标签</text>
    </view>
  </view>
  <view class="card" data-b="B704">
    <dev-badge wx:if="{{developerMode}}" code="B704" />
    <view class="row" data-z="Z704-8" bindtap="goLabels">
      <view><view class="section-title">常用标签</view><view class="subtitle">加星的标签显示在时间块右侧，最多八个</view></view>
      <text class="link">›</text>
    </view>
  </view>
  <view class="card" data-b="B225">
    <dev-badge wx:if="{{developerMode}}" code="B225" />
    <view class="row"><view><view class="section-title">时间块统计</view></view><text class="link" data-z="Z225-1" bindtap="goStats">查看 ›</text></view>
  </view>
</view>
