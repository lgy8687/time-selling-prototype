.time-fields { display: flex; gap: 12rpx; margin-top: 18rpx; }
.time-fields picker { flex: 1; }
.mode-list { display: flex; flex-direction: column; gap: 10rpx; margin-top: 10rpx; }
.mode-list view { padding: 18rpx; border-radius: 14rpx; background: #f5f7f4; }
.mode-list .chosen,.choice-row .chosen { background: #e8f3ea; color: #236e53; font-weight: 700; }
.choice-row { display: flex; gap: 10rpx; margin-top: 12rpx; }
.choice-row text { flex: 1; padding: 15rpx 8rpx; border-radius: 14rpx; text-align: center; background: #f5f7f4; font-size: 23rpx; }
.link { color: #236e53; font-size: 38rpx; }
