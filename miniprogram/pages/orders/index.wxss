.order-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; background:#fff; border-radius:22rpx; padding:24rpx; margin:18rpx 0; }.order-row .section-title { margin-bottom: 8rpx; }.status { color: #236e53; font-size: 24rpx; white-space: nowrap; }.back { display: block; color: #236e53; margin-bottom: 28rpx; }.detail { padding: 15rpx 0; border-bottom: 1rpx solid #ebf0eb; }.actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 25rpx; }.actions .btn { flex: 1; min-width: 180rpx; }.notice { margin-top: 25rpx; }.empty { color: #849389; }
