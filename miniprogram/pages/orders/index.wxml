<view class="page" data-b="B230"><dev-badge wx:if="{{developerMode}}" code="B230"/><view class="title">{{role === 'buyer' ? '我买到的' : '预约记录'}}</view><view class="subtitle">本机演示：买家提交请求，卖家确认后才写入正式时间块；开团达到人数才生效。</view>
<view wx:if="{{!selected}}"><view wx:if="{{!orders.length}}" class="empty">暂无预约记录。可以到自己的服务详情体验预约流程。</view><view wx:for="{{orders}}" wx:key="id" class="order-row" data-id="{{item.id}}" data-z="Z230-1" bindtap="open"><view><view class="section-title">{{item.serviceTitle}}</view><view class="subtitle">{{item.buyerName}} · {{item.date}} {{item.start}}—{{item.end}}</view></view><text class="status">{{item.statusText}} ›</text></view></view>
<view wx:else class="card" data-b="B231"><dev-badge wx:if="{{developerMode}}" code="B231"/><text class="back" data-z="Z231-1" bindtap="backList">‹ 全部预约</text><view class="section-title">{{selected.serviceTitle}}</view><view class="status">{{selected.statusText}}</view><view class="detail">体验买家：{{selected.buyerName}}</view><view class="detail">时间：{{selected.date}} {{selected.start}}—{{selected.end}}</view><view class="detail">形式：{{selected.bookingMode}}</view><view class="detail">补充信息：{{selected.buyerNote || '无'}}</view><view class="detail">来源：买家预约请求（本机演示）</view><view wx:if="{{selected.status === 'pending' && role === 'seller'}}" class="actions"><button class="btn" data-status="confirmed" data-z="Z231-2" bindtap="changeStatus">卖家确认</button><button class="btn secondary" data-status="rejected" data-z="Z231-3" bindtap="changeStatus">拒绝</button><button class="btn secondary" data-status="cancelled" data-z="Z231-4" bindtap="changeStatus">取消请求</button></view><button class="btn secondary" data-z="Z231-5" bindtap="openService">查看服务详情</button><view class="notice">当前没有真实买家账号、付款或跨设备通知。</view></view></view>
