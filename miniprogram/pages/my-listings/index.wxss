.listing-page { padding-bottom: 80rpx; }.page-title { justify-content: space-between; }.back-link { display: inline-flex; align-items: center; min-height: 70rpx; padding: 8rpx 22rpx; border: 2rpx solid #a8c7b2; border-radius: 18rpx; background: #e8f3ea; color: #236e53; font-weight: 700; }.listing-page .title { margin: 14rpx 0 6rpx; }.published-card { margin-top: 24rpx; }.published-row { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 0; border-bottom: 1rpx solid #e9efe9; }.published-main { flex: 1; min-width: 0; }.published-title { font-weight: 700; font-size: 27rpx; margin-bottom: 6rpx; }.published-card .btn { width: 100%; margin-top: 24rpx; }.empty { padding: 36rpx 0; color: #82948a; }