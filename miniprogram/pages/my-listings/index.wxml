<view class="page listing-page" data-b="B611"><view class="row page-title"><view class="back-link" data-z="Z611-1" bindtap="back">← 返回</view><dev-badge wx:if="{{developerMode}}" code="B611" /></view><view class="title">我发布的</view><view class="subtitle">草稿与本机发布 · 点开后与买家看到的是同一详情页</view><view class="card published-card" data-b="B605"><dev-badge wx:if="{{developerMode}}" code="B605" /><view class="section-title">全部内容 · {{listings.length}}</view><view wx:if="{{!listings.length}}" class="empty">还没有发布内容</view><view wx:for="{{listings}}" wx:key="id" class="published-row" data-id="{{item.id}}" data-z="Z605-2" bindtap="openListing"><view class="published-main"><view class="published-title">{{item.title}}</view><view class="small muted">{{item.kindLabel}} · {{item.statusLabel}} · ¥{{item.price || '—'}}</view></view><text>›</text></view><button class="btn secondary" data-z="Z605-1" bindtap="goPublish">继续发布</button></view></view>