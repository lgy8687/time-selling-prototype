.hero { padding: 35rpx 8rpx 24rpx; }.hero .title { margin-top: 18rpx; }.hero .subtitle { margin-top: 10rpx; }.category-scroll { white-space: nowrap; margin: 4rpx 0 10rpx; }.categories { display: flex; gap: 12rpx; }.category { display: inline-block; padding: 13rpx 20rpx; background: #fff; color: #6e8178; border-radius: 999rpx; font-size: 23rpx; }.category.on { color: #fff; background: #236e53; }.section-row { margin: 25rpx 4rpx 5rpx; }.listing { padding: 24rpx; }.avatar { flex-shrink: 0; width: 82rpx; height: 82rpx; border-radius: 23rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; }.avatar.peach { background: #fcecdf; }.avatar.mint { background: #e1f1e8; }.avatar.lilac { background: #ede9fa; }.avatar.blue { background: #e6effa; }.listing-main { flex: 1; min-width: 0; }.listing-title { font-size: 29rpx; font-weight: 700; }.price { color: #b47736; font-size: 29rpx; font-weight: 700; }.description { line-height: 1.5; margin: 20rpx 0; font-size: 25rpx; }.bottom-note { margin-top: 26rpx; }.overlay { position: fixed; inset: 0; background: rgba(11,31,23,.4); display: flex; align-items: flex-end; z-index: 20; }.sheet { box-sizing: border-box; width: 100%; background: #fff; border-radius: 34rpx 34rpx 0 0; padding: 32rpx 30rpx calc(34rpx + env(safe-area-inset-bottom)); }.close { font-size: 50rpx; color: #6e8178; }.detail-title { font-size: 38rpx; font-weight: 700; margin-top: 20rpx; }.detail-meta { margin: 20rpx 0; color: #b47736; }.sheet .btn { margin-top: 25rpx; }
