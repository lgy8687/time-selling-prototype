<view wx:if="{{service}}" class="page service-page" data-b="B307"><dev-badge wx:if="{{developerMode}}" code="B307" />
  <view class="service-hero"><view class="row"><text class="pill">{{service.kindLabel}}</text><text class="small muted">{{service.statusLabel}}</text></view><view class="title">{{service.title}}</view><view class="host-line"><view class="host-avatar">{{service.avatar}}</view><view><view>{{service.host}}</view><view class="small muted">{{service.category}}</view></view></view></view>
  <view class="card price-card"><view><text class="price">¥{{service.price || '—'}}</text><text class="small muted">{{service.pricingLines.length > 1 ? ' 起' : ' / ' + (service.priceUnit || '按次')}}</text></view><view class="subtitle">{{service.duration || '—'}} 分钟 · {{service.audienceLabel}}</view><view wx:for="{{service.pricingLines}}" wx:key="label" class="info-row"><text>{{item.label}}</text><text>¥{{item.price}}</text></view></view>
  <view class="card"><view class="section-title">我能提供什么</view><view class="body-text">{{service.offer || '发布者尚未填写服务介绍。'}}</view></view>
  <view wx:if="{{service.resume.length}}" class="card" data-b="B308"><dev-badge wx:if="{{developerMode}}" code="B308" /><view class="section-title">履历介绍</view><view wx:for="{{service.resume}}" wx:key="index" class="resume-detail"><text class="resume-number">{{index + 1}}</text><text>{{item}}</text></view></view>
  <view class="card"><view class="section-title">服务安排</view><view class="info-row"><text>服务方式</text><text>{{service.kind === 'errand' ? service.timeModeLabel : service.modeLabel}}</text></view><view class="info-row"><text>{{service.kind === 'errand' ? '服务范围' : '场地'}}</text><text>{{service.venueLabel}}</text></view><view wx:if="{{service.kind === 'errand'}}" class="info-row"><text>接单上限</text><text>{{service.audienceLabel}}</text></view><view wx:if="{{service.kind === 'experience' && service.hasGroup}}" class="notice">达到 {{service.minPeople}} 人后成团；本机演示尚不能接收真实报名。</view></view>
  <view class="card"><view class="section-title">可选时间</view><view wx:if="{{!service.windowLabels.length}}" class="empty">尚未设置开放时间。</view><view wx:for="{{visibleWindows}}" wx:key="id" class="window-detail"><text>{{item.date}}　{{item.start}}—{{item.end}}</text><text class="{{item.available ? 'ok' : 'unavailable'}}">{{item.available ? '可选择' : '已占用或过期'}}</text></view></view>
  <view class="notice final-note">本机演示页面。其他用户目前无法看到这条发布，也不能完成真实预约或付款。</view>
  <view wx:if="{{service.owner}}" class="owner-actions" data-b="B309"><dev-badge wx:if="{{developerMode}}" code="B309" /><button class="btn secondary" data-z="Z309-1" bindtap="edit">编辑发布</button><button class="btn" data-z="Z309-2" bindtap="openChooser">预览买家选时间</button></view>
  <view wx:else class="owner-actions"><button class="btn" data-z="Z307-1" bindtap="openChooser">选择时间</button></view>
</view>
<view wx:else class="page" data-b="B311"><dev-badge wx:if="{{developerMode}}" code="B311" /><view class="empty">这条服务已不存在。</view></view>
<view wx:if="{{chooserOpen}}" class="overlay" data-b="B310"><view class="sheet"><dev-badge wx:if="{{developerMode}}" code="B310" /><view class="row"><view class="section-title">选择服务时间</view><text class="close" data-z="Z310-1" bindtap="closeChooser">×</text></view><view class="subtitle">买家会先看到发布者可用的时间。</view><view wx:if="{{!visibleWindows.length}}" class="empty">当前没有可选时间。</view><view wx:for="{{visibleWindows}}" wx:key="id" class="choose-window {{item.available ? '' : 'disabled'}}" data-index="{{index}}" data-z="Z310-2" bindtap="selectWindow"><text>{{item.date}}　{{item.start}}—{{item.end}}</text><text>{{item.available ? '选择 ›' : '不可选'}}</text></view><view class="notice">本机演示不会生成订单或扣减接单上限。</view></view></view>
