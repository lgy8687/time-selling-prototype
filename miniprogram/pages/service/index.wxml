<view wx:if="{{service}}" class="page service-page" data-b="B307"><dev-badge wx:if="{{developerMode}}" code="B307" />
  <view class="service-hero" data-b="B312"><dev-badge wx:if="{{developerMode}}" code="B312" /><view class="row"><text class="pill">{{service.kindLabel}}</text><text class="small muted">{{service.statusLabel}}</text></view><view class="title">{{service.title}}</view><view class="host-line"><view class="host-avatar">{{service.avatar}}</view><view><view>{{service.host}}</view><view class="small muted">{{service.category}}</view></view></view></view>
  <view class="card price-card" data-b="B313"><dev-badge wx:if="{{developerMode}}" code="B313" /><view><text class="price">¥{{service.price || '—'}}</text><text class="small muted">{{service.pricingLines.length > 1 ? ' 起' : ' / ' + (service.priceUnit || '按次')}}</text></view><view class="subtitle">{{service.duration || '—'}} 分钟 · {{service.audienceLabel}}</view><view wx:for="{{service.pricingLines}}" wx:key="label" class="info-row"><text>{{item.label}}</text><text>¥{{item.price}}</text></view></view>
  <view class="card" data-b="B314"><dev-badge wx:if="{{developerMode}}" code="B314" /><view class="section-title">我能提供什么</view><view class="body-text">{{service.offer || '发布者尚未填写服务介绍。'}}</view></view>
  <view wx:if="{{service.resume.length}}" class="card" data-b="B308"><dev-badge wx:if="{{developerMode}}" code="B308" /><view class="section-title">履历介绍</view><view wx:for="{{service.resume}}" wx:key="index" class="resume-detail"><text class="resume-number">{{index + 1}}</text><text>{{item}}</text></view></view>
  <view class="card" data-b="B315"><dev-badge wx:if="{{developerMode}}" code="B315" /><view class="section-title">服务安排</view><view class="info-row"><text>服务方式</text><text>{{service.kind === 'errand' ? service.timeModeLabel : service.modeLabel}}</text></view><view class="info-row"><text>{{service.kind === 'errand' ? '服务范围' : '场地'}}</text><text>{{service.venueLabel}}</text></view><view wx:if="{{service.kind === 'errand'}}" class="info-row"><text>接单上限</text><text>{{service.audienceLabel}}</text></view><view wx:if="{{service.kind === 'experience' && service.hasGroup}}" class="notice">达到 {{service.minPeople}} 人后成团；本机演示尚不能接收真实报名。</view></view>
  <view class="card" data-b="B316"><dev-badge wx:if="{{developerMode}}" code="B316" /><view class="section-title">可选时间</view><view wx:if="{{!service.windowLabels.length}}" class="empty">尚未设置售卖时间。</view><view wx:for="{{visibleWindows}}" wx:key="id" class="window-detail"><text>{{item.date}}　{{item.start}}—{{item.end}}</text><text class="{{item.available ? 'ok' : 'unavailable'}}">{{item.available ? '可选择' : '已满或过期'}} · {{item.count}} 人申请</text></view></view>
  <view class="notice final-note">本机演示页面。其他用户目前无法看到这条发布，也不能完成真实预约或付款。</view>
  <view wx:if="{{service.owner}}" class="owner-actions" data-b="B309"><dev-badge wx:if="{{developerMode}}" code="B309" /><button class="btn secondary" data-z="Z309-1" bindtap="edit">编辑</button><button class="btn secondary" data-z="Z309-3" bindtap="unlist">下架</button><button class="btn" data-z="Z309-2" bindtap="openChooser">体验预约</button></view>
  <view wx:else class="owner-actions"><button class="btn" data-z="Z307-1" bindtap="openChooser">选择时间</button></view>
</view>
<view wx:else class="page" data-b="B311"><dev-badge wx:if="{{developerMode}}" code="B311" /><view class="empty">这条服务已不存在。</view></view>
<view wx:if="{{chooserOpen}}" class="overlay" data-b="B310"><view class="sheet"><dev-badge wx:if="{{developerMode}}" code="B310" /><view class="row"><view class="section-title">选择服务时间</view><text class="close" data-z="Z310-1" bindtap="closeChooser">×</text></view><view class="subtitle">先提交预约，等待卖家确认。</view><view wx:if="{{!visibleWindows.length}}" class="empty">当前没有可选时间。</view><view wx:for="{{visibleWindows}}" wx:key="id" class="choose-window {{item.available ? '' : 'disabled'}}" data-index="{{index}}" data-z="Z310-2" bindtap="selectWindow"><text>{{item.date}}　{{item.start}}—{{item.end}}</text><text>{{item.available ? '选择 ›' : '不可选'}}</text></view><view class="notice">仅供本机演示，不会真实通知其他用户或收款。</view></view></view>
<view wx:if="{{requestOpen}}" class="overlay" data-b="B317"><view class="sheet"><dev-badge wx:if="{{developerMode}}" code="B317" /><view class="row"><view class="section-title">提交预约请求</view><text class="close" data-z="Z317-1" bindtap="closeRequest">×</text></view><view class="subtitle">{{visibleWindows[chosenIndex].date}}　{{visibleWindows[chosenIndex].start}}—{{visibleWindows[chosenIndex].end}}</view><view class="field-label">体验买家称呼</view><input class="input" placeholder="如：小王" value="{{buyerName}}" data-field="buyerName" data-z="Z317-2" bindinput="requestField"/><view class="field-label">补充信息</view><textarea class="input note-input" placeholder="想了解的内容或见面说明" value="{{buyerNote}}" data-field="buyerNote" data-z="Z317-3" bindinput="requestField"/><view wx:if="{{service.hasGroup}}" class="mode-picks"><text class="{{bookingMode === '一对一' ? 'on' : ''}}" data-mode="一对一" data-z="Z317-4" bindtap="chooseBookingMode">一对一</text><text class="{{bookingMode === '开团' ? 'on' : ''}}" data-mode="开团" data-z="Z317-5" bindtap="chooseBookingMode">开团</text></view><button class="btn" data-z="Z317-6" bindtap="submitRequest">提交本机演示请求</button></view></view>
