<view class="page" data-b="B601"><view class="profile row"><view class="avatar" data-z="Z601-1" bindtap="chooseAvatar"><image wx:if="{{profile.avatar}}" src="{{profile.avatar}}" mode="aspectFill"/><text wx:else>{{avatarInitial}}</text></view><view class="grow" data-z="Z601-2" bindtap="edit"><view class="title">{{profile.name}} ›</view><view class="subtitle">点头像换照片 · 点名字修改昵称</view></view><text class="settings" data-section="设置" data-z="Z601-3" bindtap="openSection">⚙</text></view><view class="banner"><view>你的时间，由你决定何时开放。</view><text>先管理安排，再分享经验。</text></view><view class="card"><view class="section-title">我的交易</view><view class="trade-grid"><view data-section="我发布的" data-z="Z601-4" bindtap="openSection"><text class="trade-icon">▣</text><text>我发布的</text><text class="trade-count">{{draftCount}}</text></view><view data-section="我卖出的" data-z="Z601-5" bindtap="openSection"><text class="trade-icon">◷</text><text>我卖出的</text><text class="trade-count">0</text></view><view data-section="我买到的" data-z="Z601-6" bindtap="openSection"><text class="trade-icon">▤</text><text>我买到的</text><text class="trade-count">0</text></view><view data-section="我可卖的" data-z="Z601-7" bindtap="openSection"><text class="trade-icon">◉</text><text>我可卖的</text><text class="trade-count">{{openCount}}</text></view></view></view><view class="card"><view class="section-title">我的工具</view><view class="tool-grid"><view data-z="Z601-8" bindtap="goSchedule"><text class="tool-icon">▦</text><text>时间表</text><text class="small muted">{{eventCount}} 项安排</text></view><view data-z="Z601-9" bindtap="goPublish"><text class="tool-icon">＋</text><text>发布草稿</text><text class="small muted">{{draftCount}} 份</text></view><view data-section="我的资料" data-z="Z601-10" bindtap="openSection"><text class="tool-icon">▥</text><text>我的资料</text><text class="small muted">服务介绍</text></view><view data-section="帮助与客服" data-z="Z601-11" bindtap="openSection"><text class="tool-icon">?</text><text>帮助与客服</text><text class="small muted">使用说明</text></view></view></view><view class="version">时间售卖 {{version}} · 本地演示</view></view>
<view wx:if="{{editing}}" class="overlay" data-b="B602"><view class="sheet"><view class="row"><view class="section-title">修改昵称</view><text class="close" data-z="Z602-1" bindtap="closeEdit">×</text></view><input class="input" value="{{nameInput}}" maxlength="20" data-z="Z602-2" bindinput="inputName"/><button class="btn" data-z="Z602-3" bindtap="saveName">保存昵称</button></view></view>
<view wx:if="{{section}}" class="overlay" data-b="B603"><view class="sheet"><view class="row"><view class="section-title">{{section}}</view><text class="close" data-z="Z603-1" bindtap="closeSection">×</text></view><view wx:if="{{section === '设置'}}" data-b="B604"><view class="info-row">昵称 <text>{{profile.name}}</text></view><view class="info-row">版本 <text>{{version}}</text></view><view class="notice">当前资料和时间只保存在本机。换设备不会自动同步。</view></view><view wx:elif="{{section === '我发布的'}}" data-b="B605"><view class="subtitle">已保存 {{draftCount}} 份本机草稿。去“发布”查看或删除。</view><button class="btn secondary" data-z="Z605-1" bindtap="goPublish">打开发布</button></view><view wx:elif="{{section === '我可卖的'}}" data-b="B606"><view class="subtitle">现有 {{openCount}} 段未冲突的开放时间。去时间表调整。</view><button class="btn secondary" data-z="Z606-1" bindtap="goSchedule">打开时间表</button></view><view wx:else data-b="B607"><view class="subtitle">这里会承载{{section}}的真实数据。当前演示版暂未接入账户、订单或客服系统。</view></view></view></view>
