.profile { margin: 15rpx 0 25rpx; }.avatar { width: 95rpx; height: 95rpx; flex-shrink: 0; border-radius: 30rpx; background: #d6ee9a; display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 700; overflow: hidden; }.avatar image { width: 100%; height: 100%; }.grow { flex: 1; min-width: 0; }.profile .title { font-size: 34rpx; }.settings { font-size: 44rpx; color: #172c26; padding: 10rpx; }.banner { border-radius: 26rpx; background: linear-gradient(110deg,#d9edb5,#edf7df); padding: 28rpx; font-size: 30rpx; font-weight: 700; }.banner text { display: block; font-size: 23rpx; color: #4d6b45; margin-top: 7rpx; font-weight: 400; }.trade-grid,.tool-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 8rpx; margin-top: 20rpx; text-align: center; }.trade-grid view,.tool-grid view { display: flex; flex-direction: column; align-items: center; gap: 6rpx; font-size: 22rpx; }.trade-icon { font-size: 44rpx; line-height: 58rpx; }.trade-count { font-size: 22rpx; font-weight: 700; color: #236e53; }.tool-grid { grid-template-columns: repeat(2,1fr); row-gap: 25rpx; }.tool-grid view { background: #f7f8f5; border-radius: 20rpx; padding: 18rpx; }.tool-icon { font-size: 42rpx; color: #236e53; }.version { text-align: center; color: #8a9a90; font-size: 21rpx; padding: 30rpx; }.overlay { position: fixed; inset: 0; z-index: 20; background: rgba(11,31,23,.4); display: flex; align-items: flex-end; }.sheet { box-sizing: border-box; width: 100%; background: #fff; border-radius: 34rpx 34rpx 0 0; padding: 32rpx 30rpx calc(34rpx + env(safe-area-inset-bottom)); }.close { font-size: 50rpx; color: #6e8178; }.sheet .input,.sheet .btn { margin-top: 20rpx; }.info-row { display: flex; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid #ebefea; }.info-row text { color: #6e8178; }.sheet .notice { margin-top: 18rpx; }

.published-list { max-height: 45vh; margin-top: 15rpx; }
.published-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid #edf0ed; font-size: 24rpx; }
.published-row > view { flex: 1; min-width: 0; }
.published-row > view > view:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
.published-row > text { color: #236e53; font-size: 32rpx; }

.banner { position: relative; }
.banner-code { position: absolute; top: 8rpx; right: 18rpx; width: auto; }
