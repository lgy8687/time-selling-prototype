.time-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.mode-list { display: flex; flex-direction: column; gap: 12rpx; margin: 14rpx 0; }
.mode-list view { display: flex; justify-content: space-between; padding: 20rpx; border-radius: 16rpx; background: #f7f8f5; font-size: 25rpx; }
.mode-list view text { color: #6e8178; }
.mode-list .chosen { background: #e8f3ea; color: #236e53; box-shadow: inset 0 0 0 2rpx #a7c9b4; }
.palette-field { display: flex; align-items: center; gap: 14rpx; margin-top: 14rpx; }
.palette-field .input { flex: 1; }
.palette-dot { width: 24rpx; height: 24rpx; border-radius: 50%; flex-shrink: 0; }
.palette-dot.blue { background: #80b2dd; }.palette-dot.mint { background: #8bc9ab; }.palette-dot.gray { background: #a5ada5; }.palette-dot.yellow { background: #e8bf66; }
.card .btn { margin-top: 20rpx; }
.switch-row { margin-top: 20rpx; }
.code-panel { border-top: 1rpx solid #edf0ed; margin-top: 20rpx; padding-top: 20rpx; }
.code-help { margin: 14rpx 0; }
.code-scroll { height: 520rpx; }
.code-row { display: flex; gap: 12rpx; align-items: center; padding: 17rpx 4rpx; border-bottom: 1rpx solid #edf0ed; font-size: 22rpx; }
.code { flex-shrink: 0; font-weight: 700; color: #236e53; background: #e8f3ea; padding: 5rpx 9rpx; border-radius: 7rpx; }
.code-name { flex: 1; color: #6e8178; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.copy { color: #236e53; }
.version { text-align: center; color: #8a9a90; font-size: 21rpx; padding: 28rpx 0 8rpx; }
.storage-note { text-align: center; font-size: 21rpx; }
