.schedule-page {
  box-sizing: border-box;
  height: calc(100vh - 126rpx - env(safe-area-inset-bottom));
  padding: 0 18rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.toolbar {
  box-sizing: border-box;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-left: 12rpx;
  padding-bottom: 12rpx;
}
.month-label { color: #172c26; font-size: 36rpx; font-weight: 700; min-width: 100rpx; }
.layout-icons { display: flex; align-items: center; gap: 12rpx; }
.icon-button {
  box-sizing: border-box;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #172c26;
  font-size: 35rpx;
  border-radius: 12rpx;
}
.icon-button.active { color: #236e53; background: #e8f3ea; }
.month-calendar {
  flex-shrink: 0;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #e7ede7;
  border-radius: 18rpx;
  padding: 9rpx 5rpx 7rpx;
  overflow: hidden;
}
.weekday-head,.month-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
.weekday-head { color: #819288; text-align: center; font-size: 20rpx; padding: 0 0 7rpx; }
.month-viewport { overflow: hidden; }
.month-grid { height: 516rpx; grid-template-rows: repeat(6, 86rpx); }
.month-day {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  overflow: hidden;
  padding: 5rpx 4rpx;
  border: 1rpx solid #f0f3ef;
}
.month-day.current { background: #e8f3ea; color: #236e53; }
.month-day.outside { opacity: .36; }
.day-number { font-size: 23rpx; text-align: center; line-height: 28rpx; }
.event-chip {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  background: #e7f4eb;
  color: #274d3d;
  border-radius: 5rpx;
  margin-top: 3rpx;
  padding: 1rpx 3rpx;
  font-size: 17rpx;
  line-height: 20rpx;
}
.event-chip.reserved { background: #dfeef9; }
.event-chip.blocked { background: #e6ebe6; }
.event-chip.pending { background: #fff0ce; }
.extra { display: block; text-align: right; color: #236e53; font-size: 17rpx; line-height: 19rpx; }
.agenda,.calendar {
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
  margin-top: 8rpx;
  background: #fff;
  border: 1rpx solid #e7ede7;
  border-radius: 18rpx;
  overflow: hidden;
}
.agenda-scroll { box-sizing: border-box; height: 100%; padding: 0 16rpx; }
.agenda-empty { padding: 35rpx 12rpx; color: #8a9a90; font-size: 23rpx; text-align: center; }
.agenda-row { display: flex; align-items: center; gap: 14rpx; min-height: 82rpx; border-bottom: 1rpx solid #edf0ed; }
.agenda-time { width: 142rpx; flex-shrink: 0; color: #6e8178; font-size: 20rpx; }
.agenda-name {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  border-left: 5rpx solid #80b2dd;
  padding-left: 12rpx;
  font-size: 23rpx;
}
.agenda-row.blocked .agenda-name { border-color: #a5ada5; }
.agenda-row.pending .agenda-name { border-color: #e8bf66; }
.agenda-arrow { color: #8a9a90; font-size: 29rpx; }
.calendar { display: flex; flex-direction: column; }
.block-toolbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  min-height: 70rpx;
  padding: 0 6rpx;
  border-bottom: 1rpx solid #e8eee8;
}
.tool-icon {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 65rpx;
  height: 60rpx;
  border-radius: 12rpx;
  color: #355b4b;
  font-size: 32rpx;
}
.tool-icon:active { background: #e8f3ea; }
.calendar-body { position: relative; display: flex; flex: 1; min-height: 0; }
.calendar-scroll { box-sizing: border-box; width: 67%; height: 100%; padding: 0 5rpx; }
.calendar-body.wide .calendar-scroll { width: 100%; }
.wide-marker { position: absolute; right: 0; top: 0; z-index: 1; }
.hour-row { display: flex; border-bottom: 1rpx solid #e4ebe4; }
.hour {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 67rpx;
  flex-shrink: 0;
  color: #6e8178;
}
.hour-cells { display: flex; flex: 1; min-width: 0; gap: 3rpx; padding: 2rpx 0; }
.grid-cell {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  overflow: hidden;
  border: 2rpx solid #fff;
  border-radius: 3rpx;
  background: #e9ebea;
}
.grid-cell.reserved { background: #dcebf7; }
.grid-cell.blocked { background: #e6ebe6; }
.grid-cell.pending { background: #fff0ce; }
.grid-cell.selected { border-color: #236e53; background: #d9efdf; }
.cell-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
.right-rail {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 33%;
  height: 100%;
  border-left: 1rpx solid #e4ebe4;
  padding: 6rpx 6rpx 0;
}
.palette { flex-shrink: 0; max-height: 73%; overflow-y: auto; }
.palette-item {
  display: flex;
  align-items: center;
  min-height: 48rpx;
  margin-bottom: 6rpx;
  padding: 3rpx 6rpx;
  border-radius: 8rpx;
  color: #fff;
  background: #69b888;
  font-size: 20rpx;
}
.palette-item.blue { background: #76a8d8; }
.palette-item.mint { background: #68b883; }
.palette-item.gray { background: #97a59b; }
.palette-item.yellow { background: #d7aa5b; }
.palette-name { flex: 1; overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.palette-arrow { width: 28rpx; text-align: center; font-size: 30rpx; }
.more-labels { padding: 10rpx 2rpx; color: #6e8178; font-size: 20rpx; text-align: center; }
.operation-zone { flex: 1; min-height: 90rpx; margin-top: 9rpx; padding: 10rpx 4rpx; border-top: 2rpx solid #dce7df; }
.selection-note { color: #236e53; font-size: 18rpx; overflow-wrap: anywhere; }
.selection-hint { color: #829388; font-size: 18rpx; }
.clear-record,.undo-record {
  margin-top: 12rpx;
  padding: 11rpx 3rpx;
  border: 1rpx solid #ddb3a5;
  border-radius: 9rpx;
  color: #9b4834;
  text-align: center;
  font-size: 20rpx;
}
.undo-record { border-color: #a9c9b2; color: #236e53; }
.calendar.fullscreen {
  position: fixed;
  inset: 0;
  z-index: 1200;
  box-sizing: border-box;
  height: 100vh;
  margin: 0;
  padding: calc(24rpx + env(safe-area-inset-top)) 12rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 0;
}
