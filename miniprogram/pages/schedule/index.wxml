<view class="page" data-b="B201" data-z="Z201-9" bindtouchstart="pageTouchStart" bindtouchend="pageTouchEnd"><dev-badge wx:if="{{developerMode}}" code="B201" />
  <view class="row page-head"><view><view class="title">时间表</view><view class="subtitle">私人安排和开放时间，共用同一张表</view></view><view class="settings-link" data-z="Z201-1" bindtap="goSettings">设置</view></view>
  <view class="card toolbar">
    <view class="row"><view class="date-label">{{dateLabel}}</view><view class="row nav-actions"><text data-z="Z201-2" bindtap="goToday">今天</text><text data-count="-1" data-z="Z201-3" bindtap="shift">‹</text><text data-count="1" data-z="Z201-4" bindtap="shift">›</text></view></view>
    <view class="view-switch"><text class="{{view === 'month' ? 'selected' : ''}}" data-view="month" data-z="Z201-7" bindtap="setView">月＋列表</text><text class="{{view === 'week' ? 'selected' : ''}}" data-view="week" data-z="Z201-6" bindtap="setView">周＋列表</text><text class="{{view === 'day' ? 'selected' : ''}}" data-view="day" data-z="Z201-5" bindtap="setView">日时间格</text></view>
    
  </view>
  <view wx:if="{{view === 'month'}}" class="card month-calendar" data-b="B203">
    <dev-badge wx:if="{{developerMode}}" code="B203" /><view class="weekday-head"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
    <view class="month-grid"><view wx:for="{{month}}" wx:key="date" class="month-day {{item.active ? '' : 'outside'}} {{item.selected ? 'current' : ''}}" data-date="{{item.date}}" data-z="Z203-1" bindtap="chooseDate"><text class="day-number">{{item.day}}</text><view wx:for="{{item.chips}}" wx:for-item="chip" wx:key="id" class="event-chip {{chip.type}}">{{chip.title}}</view><text wx:if="{{item.extra}}" class="extra">+{{item.extra}}</text></view></view>
    <view class="calendar-hint">向上滚动页面，收起为本周</view>
  </view>
  <view wx:if="{{view === 'week'}}" class="card week-calendar" data-b="B202">
    <dev-badge wx:if="{{developerMode}}" code="B202" /><view class="week-grid"><view wx:for="{{week}}" wx:key="date" class="week-day {{item.selected ? 'current' : ''}}" data-date="{{item.date}}" data-z="Z202-1" bindtap="chooseDate"><text>周{{item.label}}</text><text class="week-number">{{item.day}}</text><text class="week-count">{{item.count ? item.count + '项' : '·'}}</text></view></view>
    <view class="calendar-hint">向下滚动页面，展开整月</view>
  </view>
  <view wx:if="{{view !== 'day'}}" class="card agenda" data-b="B212"><dev-badge wx:if="{{developerMode}}" code="B212" /><view class="row"><view><view class="section-title">{{dateLabel}}的安排</view><view class="subtitle">{{eventCount}} 项安排</view></view><view class="pill" data-z="Z212-1" bindtap="addEvent">＋ 添加</view></view>
    <view wx:if="{{!agenda.length}}" class="agenda-empty">这一天还没有安排。点“添加”记下课程或开放时间。</view>
    <view wx:for="{{agenda}}" wx:key="id" class="agenda-row {{item.type}}" data-eventid="{{item.id}}" data-z="Z212-2" bindtap="openAgenda"><text class="agenda-time">{{item.range}}</text><view class="agenda-detail"><text class="agenda-name">{{item.title}}</text><text class="agenda-type">{{item.typeLabel}}</text></view><text class="agenda-arrow">›</text></view>
    
  </view>
  <view wx:if="{{view === 'day'}}" class="card calendar" data-b="B204">
    <dev-badge wx:if="{{developerMode}}" code="B204" /><view class="row"><view><view class="section-title">{{dateLabel}}</view><view class="small muted">{{modeLabel}} · 当日 {{eventCount}} 项</view></view><view class="pill" data-z="Z204-1" bindtap="addEvent">＋ 添加</view></view>
    <view class="legend"><text>● 已安排</text><text>● 私人占用</text><text>● 开放时间</text></view>
    <view class="selection-slot"><view wx:if="{{selectedLabel}}" class="selection-bar" data-b="B213"><view><text>已选 {{selectedLabel}}</text><text wx:if="{{selectionHint}}" class="selection-hint">再点单格或选区两端可取消</text></view><dev-badge wx:if="{{developerMode}}" code="B213" /></view><view wx:else class="selection-placeholder" data-b="B214">点时间格选择连续时段，再点右侧标签<dev-badge wx:if="{{developerMode}}" code="B214" /></view></view>
    <view class="calendar-body {{paletteHidden ? 'wide' : ''}}" data-z="Z204-3" bindtouchstart="gridTouchStart" bindtouchmove="gridTouchMove" bindtouchend="gridTouchEnd">
      <scroll-view scroll-y class="calendar-scroll">
        <view wx:for="{{hourRows}}" wx:key="hourNumber" class="hour-row"><view class="hour">{{item.label}}</view><view class="hour-cells"><view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="id" id="cell-{{cell.index}}" class="grid-cell {{cell.type}} {{cell.selected ? 'selected' : ''}}" style="flex:{{cell.flex}}" data-index="{{cell.index}}" data-z="Z204-2" bindtap="openSlot" bindlongpress="longPressSlot"><text wx:if="{{cell.title}}" class="cell-title">{{cell.title}}</text><text wx:elif="{{!cell.eventId}}" class="cell-plus">＋</text><text class="cell-time">{{cell.start}}</text></view></view></view>
      </scroll-view>
      <view wx:if="{{!paletteHidden}}" class="palette" data-b="B205"><dev-badge wx:if="{{developerMode}}" code="B205" /><text class="palette-note">先选连续时间，再点标签</text><view class="palette-items"><view wx:for="{{palette}}" wx:key="id" class="palette-item {{item.color}}" data-id="{{item.id}}" data-z="Z205-2" bindtap="choosePalette">{{item.title}}</view></view><text class="small edit-link" data-z="Z205-1" bindtap="goSettings">编辑标签</text></view>
    </view>
    <view wx:if="{{paletteHidden}}" class="grid-hint" data-b="B215">全宽时间格 · 左滑恢复标签<dev-badge wx:if="{{developerMode}}" code="B215" /></view><view wx:else class="grid-hint">在时间格右滑可放大</view>
  </view>
  <view class="card" data-b="B219"><dev-badge wx:if="{{developerMode}}" code="B219" /><view class="row"><view><view class="section-title">可分享的时间</view><view class="subtitle">仅显示没有冲突的开放时间</view></view><text class="edit-link" data-z="Z201-8" bindtap="toggleShare">查看</text></view></view>
</view>

<view wx:if="{{editor && !editing}}" class="overlay" data-b="B216">
  <view class="sheet add-sheet">
    <view class="row"><view class="section-title">添加时间 <dev-badge wx:if="{{developerMode}}" code="B216" /></view><text class="close" data-z="Z216-1" bindtap="closeEditor">×</text></view>
    <view class="type-switch"><text class="{{form.type === 'reserved' ? 'on' : ''}}" data-type="reserved" data-z="Z216-2" bindtap="chooseType">已安排</text><text class="{{form.type === 'blocked' ? 'on' : ''}}" data-type="blocked" data-z="Z216-3" bindtap="chooseType">私人占用</text><text class="{{form.type === 'open' ? 'on' : ''}}" data-type="open" data-z="Z216-4" bindtap="chooseType">开放时间</text></view>
    <text class="field-label">日期</text><picker mode="date" value="{{form.date}}" data-z="Z216-5" bindchange="editorPickDate"><view class="picker">{{form.date}}</view></picker>
    <view class="row editor-grid-heading"><view><view class="section-title">选择时间块</view><view class="small muted">连续点选；点选区两端可取消</view></view><dev-badge wx:if="{{developerMode}}" code="B218" /></view>
    <view class="editor-grid" data-b="B218">
      <scroll-view scroll-y class="editor-grid-scroll"><view wx:for="{{editorRows}}" wx:key="hourNumber" class="hour-row"><view class="hour">{{item.label}}</view><view class="hour-cells"><view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="id" class="grid-cell {{cell.type}} {{cell.selected ? 'selected' : ''}} {{cell.eventId ? 'occupied' : ''}}" style="flex:{{cell.flex}}" data-index="{{cell.index}}" data-z="Z218-1" bindtap="selectEditorSlot"><text wx:if="{{cell.title}}" class="cell-title">{{cell.title}}</text><text wx:else class="cell-time-main">{{cell.start}}</text></view></view></view></scroll-view>
      <view class="editor-palette"><view wx:for="{{palette}}" wx:key="id" class="palette-item {{item.color}} {{form.title === item.title ? 'chosen' : ''}}" data-id="{{item.id}}" data-z="Z218-2" bindtap="selectEditorPalette">{{item.title}}</view></view>
    </view>
    <view class="editor-selected">{{editorRange ? '已选：' + editorRange : '请在上方点选时间块'}}</view>
    <view wx:if="{{error}}" class="error" data-b="B211">{{error}}<dev-badge wx:if="{{developerMode}}" code="B211" /></view>
    <button class="btn save" data-z="Z216-6" bindtap="saveEvent">保存时间</button>
  </view>
</view>
<view wx:if="{{editor && editing}}" class="overlay" data-b="B206"><view class="sheet"><view class="row"><view class="section-title">编辑时间 <dev-badge wx:if="{{developerMode}}" code="B206" /></view><text class="close" data-z="Z206-1" bindtap="closeEditor">×</text></view><view class="type-switch"><text class="{{form.type === 'reserved' ? 'on' : ''}}" data-type="reserved" data-z="Z206-2" bindtap="chooseType">已安排</text><text class="{{form.type === 'blocked' ? 'on' : ''}}" data-type="blocked" data-z="Z206-3" bindtap="chooseType">私人占用</text><text class="{{form.type === 'open' ? 'on' : ''}}" data-type="open" data-z="Z206-4" bindtap="chooseType">开放时间</text></view><text class="field-label">名称（可写学生或小组名字）</text><input class="input" value="{{form.title}}" data-field="title" data-z="Z206-5" bindinput="editField" maxlength="40"/><text class="field-label">日期</text><picker mode="date" value="{{form.date}}" data-field="date" data-z="Z206-6" bindchange="editField"><view class="picker">{{form.date}}</view></picker><view class="time-fields"><view><text class="field-label">开始</text><picker mode="time" value="{{form.start}}" data-field="start" data-z="Z206-7" bindchange="editField"><view class="picker">{{form.start}}</view></picker></view><view><text class="field-label">结束</text><picker mode="time" value="{{form.end}}" data-field="end" data-z="Z206-8" bindchange="editField"><view class="picker">{{form.end}}</view></picker></view></view><view wx:if="{{error}}" class="error" data-b="B211">{{error}}<dev-badge wx:if="{{developerMode}}" code="B211" /></view><view class="row sheet-actions"><view wx:if="{{editing}}" data-b="B210"><dev-badge wx:if="{{developerMode}}" code="B210" /><button class="btn warn" data-z="Z210-1" bindtap="deleteEvent">删除</button></view><button class="btn save" data-z="Z206-10" bindtap="saveEvent">保存时间</button></view></view></view>
<view wx:if="{{shareOpen}}" class="overlay" data-b="B209"><view class="sheet"><view class="row"><view class="section-title">可分享的时间 <dev-badge wx:if="{{developerMode}}" code="B209" /></view><text class="close" data-z="Z209-1" bindtap="toggleShare">×</text></view><view class="subtitle">这里只列出未被占用的未来开放时间。正式分享和预约需要上线服务端后启用。</view><view wx:if="{{publicSlots.length === 0}}" class="empty">暂无可分享时间。先在时间表添加“开放时间”。</view><view wx:for="{{publicSlots}}" wx:key="id" class="share-row">{{item.label}}</view></view></view>
