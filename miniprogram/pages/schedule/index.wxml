<view class="page schedule-page" data-b="B201">
  <view class="toolbar" style="padding-top:{{navTop}}px;padding-right:{{navRight}}px;min-height:{{navHeight}}px" data-b="B220">
    <view class="month-label" data-z="Z220-1" bindtap="goToday">{{monthLabel}}</view>
    <view class="layout-icons">
      <view class="icon-button {{layout === 'agenda' ? 'active' : ''}}" data-layout="agenda" data-z="Z220-2" aria-label="日历与安排" bindtap="setLayout">☷</view>
      <view class="icon-button {{layout === 'blocks' ? 'active' : ''}}" data-layout="blocks" data-z="Z220-3" aria-label="日历与时间块" bindtap="setLayout">▦</view>
    </view>
    <dev-badge wx:if="{{developerMode}}" code="B201" />
    <dev-badge wx:if="{{developerMode}}" code="B220" />
  </view>
  <view class="month-calendar" data-b="B203" data-z="Z203-2" bindtouchstart="calendarTouchStart" bindtouchend="calendarTouchEnd">
    <dev-badge wx:if="{{developerMode && collapseProgress < 0.98}}" code="B203" />
    <view wx:if="{{collapseProgress >= 0.98}}" data-b="B202"><dev-badge wx:if="{{developerMode}}" code="B202" /></view>
    <view class="weekday-head"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
    <view class="month-viewport" style="height:{{calendarHeightRpx}}rpx">
      <view class="month-grid" style="transform:translateY(-{{monthOffsetRpx}}rpx)">
        <view wx:for="{{month}}" wx:key="date" class="month-day {{item.active ? '' : 'outside'}} {{item.selected ? 'current' : ''}}" data-date="{{item.date}}" data-z="Z203-1" bindtap="chooseDate">
          <text class="day-number">{{item.day}}</text>
          <view wx:for="{{item.chips}}" wx:for-item="chip" wx:key="id" class="event-chip {{chip.type}}">{{chip.title}}</view>
          <text wx:if="{{item.extra}}" class="extra">+{{item.extra}}</text>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{layout === 'agenda'}}" class="agenda" data-b="B212">
    <dev-badge wx:if="{{developerMode}}" code="B212" />
    <scroll-view scroll-y enhanced show-scrollbar="false" class="agenda-scroll" bindscroll="onContentScroll" bindtouchstart="collapseTouchStart" bindtouchmove="collapseTouchMove" bindtouchend="collapseTouchEnd">
      <view wx:if="{{!agenda.length}}" class="agenda-empty" data-b="B234">当天没有安排<dev-badge wx:if="{{developerMode}}" code="B234" /></view>
      <view wx:for="{{agenda}}" wx:key="id" class="agenda-row {{item.type}}" data-b="B233" data-eventid="{{item.id}}" data-z="Z233-1" bindtap="openAgenda">
        <text class="agenda-time">{{item.range}}</text>
        <text class="agenda-name">{{item.title}}</text>
        <text class="agenda-arrow">›</text>
        <dev-badge wx:if="{{developerMode}}" code="B233" />
      </view>
    </scroll-view>
  </view>
  <view wx:else class="calendar {{fullscreen ? 'fullscreen' : ''}}" data-b="B204">
    <view class="block-toolbar">
      <view class="tool-icon" data-z="Z204-1" aria-label="切换每小时分格" bindtap="cycleMode">{{settings.mode === 2 ? '▥' : settings.mode === 3 ? '▦' : '▧'}}</view>
      <view class="tool-icon" data-z="Z204-6" aria-label="展开或还原时间格" bindtap="togglePalette">{{paletteHidden ? '⇤' : '⇥'}}</view>
      <view class="tool-icon" data-z="Z204-7" aria-label="调整时间格高度" bindtap="cycleHeight">↕</view>
      <view class="tool-icon" data-z="Z204-4" aria-label="时间块统计" bindtap="goStats">▤</view>
      <view class="tool-icon" data-z="Z204-5" aria-label="全屏或还原" bindtap="toggleFullscreen">{{fullscreen ? '↙' : '⛶'}}</view>
      <view class="tool-icon" data-z="Z204-8" aria-label="时间块设置" bindtap="goSettings">⚙</view>
      <dev-badge wx:if="{{developerMode}}" code="B204" />
      <view wx:if="{{fullscreen}}" data-b="B222"><dev-badge wx:if="{{developerMode}}" code="B222" /></view>
    </view>
    <view class="calendar-body {{paletteHidden ? 'wide' : ''}}" data-z="Z204-3" bindtouchstart="gridTouchStart" bindtouchmove="gridTouchMove" bindtouchend="gridTouchEnd">
      <scroll-view scroll-y enhanced show-scrollbar="false" class="calendar-scroll" bindscroll="onContentScroll">
        <view wx:for="{{hourRows}}" wx:key="hourNumber" class="hour-row" style="height:{{rowHeight}}rpx">
          <view class="hour" style="font-size:{{blockFontSize}}rpx">{{item.label}}</view>
          <view class="hour-cells">
            <view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="id" id="cell-{{cell.index}}" class="grid-cell {{cell.type}} {{cell.selected ? 'selected' : ''}}" style="flex:{{cell.flex}}" data-index="{{cell.index}}" data-z="Z204-2" bindtap="openSlot" bindlongpress="longPressSlot">
              <text wx:if="{{cell.title}}" class="cell-title" style="font-size:{{blockFontSize}}rpx">{{cell.title}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{!paletteHidden}}" class="right-rail">
        <view class="palette" data-b="B205">
          <dev-badge wx:if="{{developerMode}}" code="B205" />
          <view wx:for="{{paletteRows}}" wx:key="id" class="palette-item {{item.color}}" style="font-size:{{blockFontSize}}rpx">
            <text class="palette-name" data-id="{{item.id}}" data-z="Z205-2" bindtap="choosePalette">{{item.title}}</text>
            <text wx:if="{{item.hasChildren}}" class="palette-arrow" data-id="{{item.id}}" data-z="Z205-3" catchtap="openChildLabels">›</text>
          </view>
          <view class="more-labels" data-z="Z205-1" bindtap="goMoreLabels">更多标签</view>
        </view>
        <view class="operation-zone" data-b="B232">
          <dev-badge wx:if="{{developerMode}}" code="B232" />
          <view wx:if="{{selectedLabel}}" class="selection-note" data-b="B213">{{selectedLabel}}<dev-badge wx:if="{{developerMode}}" code="B213" /></view>
          <view wx:if="{{selectionHint}}" class="selection-hint">长按可连续选择</view>
          <view wx:if="{{selectedEventId}}" class="clear-record" data-z="Z232-1" bindtap="clearSelectedEvent">清除记录</view>
          <view wx:if="{{undoEvent}}" class="undo-record" data-z="Z232-2" bindtap="undoClear">撤销清除</view>
        </view>
      </view>
      <view wx:if="{{paletteHidden}}" class="wide-marker" data-b="B215"><dev-badge wx:if="{{developerMode}}" code="B215" /></view>
    </view>
  </view>
</view>
