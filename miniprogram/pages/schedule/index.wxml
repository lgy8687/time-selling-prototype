<view class="page" data-b="B201">
  <view class="row">
    <view><view class="title">时间表</view><view class="subtitle">私人安排和开放时间，用同一张表管理</view></view>
    <view class="settings-link" data-z="Z201-1" bindtap="toggleSettings">设置</view>
  </view>
  <view class="card toolbar">
    <view class="row"><view class="date-label">{{dateLabel}}</view><view class="row nav-actions"><text data-z="Z201-2" bindtap="goToday">今天</text><text data-count="-1" data-z="Z201-3" bindtap="shift">‹</text><text data-count="1" data-z="Z201-4" bindtap="shift">›</text></view></view>
    <view class="view-switch"><text class="{{view === 'day' ? 'selected' : ''}}" data-view="day" data-z="Z201-5" bindtap="setView">日</text><text class="{{view === 'week' ? 'selected' : ''}}" data-view="week" data-z="Z201-6" bindtap="setView">周</text><text class="{{view === 'month' ? 'selected' : ''}}" data-view="month" data-z="Z201-7" bindtap="setView">月</text></view>
  </view>
  <view wx:if="{{view === 'week'}}" class="card week" data-b="B202"><view wx:for="{{week}}" wx:key="date" class="week-day {{item.selected ? 'current' : ''}}" data-date="{{item.date}}" data-z="Z202-1" bindtap="chooseDate"><text>周{{item.label}}</text><text class="week-number">{{item.day}}</text><text class="dot">{{item.count ? '•' : ' '}}</text></view></view>
  <view wx:if="{{view === 'month'}}" class="card month" data-b="B203"><view wx:for="{{month}}" wx:key="date" class="month-day {{item.active ? '' : 'outside'}} {{item.selected ? 'current' : ''}}" data-date="{{item.date}}" data-z="Z203-1" bindtap="chooseDate"><text>{{item.day}}</text><text class="dot">{{item.count ? '•' : ' '}}</text></view></view>
  <view class="card calendar" data-b="B204">
    <view class="row"><view><view class="section-title">{{dateLabel}}</view><view class="small muted">{{modeLabel}} · 当日 {{eventCount}} 项</view></view><view class="pill" data-z="Z204-1" bindtap="addEvent">＋ 添加</view></view>
    <view class="legend"><text>● 已安排</text><text>● 私人占用</text><text>● 开放时间</text></view>
    <view class="calendar-head"><text>时间</text><text>安排</text><text>标签</text></view>
    <view class="calendar-body">
    <scroll-view scroll-y class="calendar-scroll">
      <view wx:for="{{slots}}" wx:key="id" class="slot-row" data-start="{{item.start}}" data-end="{{item.end}}" data-eventid="{{item.eventId}}" data-z="Z204-2" bindtap="openSlot">
        <view class="hour">{{item.hour}}</view><view class="slot {{item.type}}"><text class="slot-time">{{item.start}}–{{item.end}}</text><text wx:if="{{item.title}}" class="slot-title">{{item.title}}</text><text wx:if="{{!item.eventId}}" class="slot-plus">＋</text></view>
      </view>
    </scroll-view>
    <view class="palette" data-b="B205"><text class="palette-note">先选标签，再点时间格</text><view class="palette-items"><view wx:for="{{palette}}" wx:key="id" class="palette-item {{item.color}} {{chosenPalette === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" data-z="Z205-2" bindtap="choosePalette">{{item.title}}</view></view><text class="small edit-link" data-z="Z205-1" bindtap="togglePalette">改名称</text></view>
    </view>
  </view>
  <view class="card"><view class="row"><view><view class="section-title">可分享的时间</view><view class="subtitle">仅展示尚未冲突的开放时间，不公开私人安排</view></view><text class="edit-link" data-z="Z201-8" bindtap="toggleShare">查看</text></view></view>
</view>

<view wx:if="{{editor}}" class="overlay" data-b="B206"><view class="sheet"><view class="row"><view class="section-title">{{editing ? '编辑时间' : '添加时间'}}</view><text class="close" data-z="Z206-1" bindtap="closeEditor">×</text></view><view class="type-switch"><text class="{{form.type === 'reserved' ? 'on' : ''}}" data-type="reserved" data-z="Z206-2" bindtap="chooseType">已安排</text><text class="{{form.type === 'blocked' ? 'on' : ''}}" data-type="blocked" data-z="Z206-3" bindtap="chooseType">私人占用</text><text class="{{form.type === 'open' ? 'on' : ''}}" data-type="open" data-z="Z206-4" bindtap="chooseType">开放时间</text></view><text class="field-label">名称（可写学生或小组名字）</text><input class="input" value="{{form.title}}" data-field="title" data-z="Z206-5" bindinput="editField" maxlength="40"/><text class="field-label">日期</text><picker mode="date" value="{{form.date}}" data-field="date" data-z="Z206-6" bindchange="editField"><view class="picker">{{form.date}}</view></picker><view class="time-fields"><view><text class="field-label">开始</text><picker mode="time" value="{{form.start}}" data-field="start" data-z="Z206-7" bindchange="editField"><view class="picker">{{form.start}}</view></picker></view><view><text class="field-label">结束</text><picker mode="time" value="{{form.end}}" data-field="end" data-z="Z206-8" bindchange="editField"><view class="picker">{{form.end}}</view></picker></view></view><view wx:if="{{error}}" class="error" data-b="B211">{{error}}</view><view class="row sheet-actions"><view wx:if="{{editing}}" data-b="B210"><button class="btn warn" data-z="Z210-1" bindtap="deleteEvent">删除</button></view><button class="btn save" data-z="Z206-10" bindtap="saveEvent">保存时间</button></view></view></view>
<view wx:if="{{settingsOpen}}" class="overlay" data-b="B207"><view class="sheet"><view class="row"><view class="section-title">时间表设置</view><text class="close" data-z="Z207-1" bindtap="toggleSettings">×</text></view><text class="field-label">每天显示的时间</text><view class="time-fields"><view><picker mode="selector" range="{{hoursStart}}" value="{{settings.startHour}}" data-key="startHour" data-z="Z207-2" bindchange="setHour"><view class="picker">{{settings.startHour}}:00 开始</view></picker></view><view><picker mode="selector" range="{{hoursEnd}}" value="{{settings.endHour - 1}}" data-key="endHour" data-z="Z207-3" bindchange="setHour"><view class="picker">{{settings.endHour}}:00 结束</view></picker></view></view><text class="field-label">每小时分格</text><view class="mode-list"><view class="{{settings.mode === 2 ? 'chosen' : ''}}" data-mode="2" data-z="Z207-4" bindtap="setMode">2 格 · 30 + 30 分钟</view><view class="{{settings.mode === 3 ? 'chosen' : ''}}" data-mode="3" data-z="Z207-5" bindtap="setMode">3 格 · 30 + 15 + 15 分钟</view><view class="{{settings.mode === 4 ? 'chosen' : ''}}" data-mode="4" data-z="Z207-6" bindtap="setMode">4 格 · 15 + 15 + 15 + 15 分钟</view></view><view class="notice">分格只影响时间表的显示和点选；已保存时间仍按真实起止时间检查冲突。</view></view></view>
<view wx:if="{{paletteOpen}}" class="overlay" data-b="B208"><view class="sheet"><view class="row"><view class="section-title">常用标签</view><text class="close" data-z="Z208-1" bindtap="togglePalette">×</text></view><view class="subtitle">把“学生名字”“小组名字”换成自己常用的称呼。</view><view wx:for="{{palette}}" wx:key="id"><text class="field-label">{{item.type === 'open' ? '开放时间' : item.type === 'blocked' ? '私人安排' : '已安排'}}标签 {{index + 1}}</text><input class="input" value="{{item.title}}" data-index="{{index}}" data-z="Z208-2" bindinput="editPalette" maxlength="20"/></view><button class="btn" data-z="Z208-3" bindtap="savePalette">保存名称</button></view></view>
<view wx:if="{{shareOpen}}" class="overlay" data-b="B209"><view class="sheet"><view class="row"><view class="section-title">可分享的时间</view><text class="close" data-z="Z209-1" bindtap="toggleShare">×</text></view><view class="subtitle">这里只列出未被占用的未来开放时间。正式分享和预约需要上线服务端后启用。</view><view wx:if="{{publicSlots.length === 0}}" class="empty">暂无可分享时间。先在时间表添加“开放时间”。</view><view wx:for="{{publicSlots}}" wx:key="id" class="share-row">{{item.label}}</view></view></view>
