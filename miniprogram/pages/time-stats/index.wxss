.period-switch { display: flex; gap: 9rpx; margin-top: 24rpx; padding: 5rpx; background: #edf3ed; border-radius: 18rpx; }.period-switch text { flex: 1; text-align: center; padding: 13rpx; border-radius: 14rpx; color: #6e8178; }.period-switch .active { background: #fff; color: #236e53; font-weight: 700; }.summary { display: flex; justify-content: space-around; }.summary view { display: flex; flex-direction: column; gap: 8rpx; color: #6e8178; text-align: center; }.summary .big { font-size: 42rpx; font-weight: 700; color: #236e53; }.table-head,.table-row { display: grid; grid-template-columns: 1fr 100rpx 160rpx; gap: 10rpx; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #e9eee9; }.table-head { color: #6e8178; font-size: 23rpx; }.table-row text { font-size: 25rpx; }.table-row .secondary { display: block; color: #6e8178; font-size: 22rpx; margin-top: 4rpx; }.empty { color: #82948a; padding: 35rpx 0; text-align: center; }.foot { margin: 22rpx 0; }
