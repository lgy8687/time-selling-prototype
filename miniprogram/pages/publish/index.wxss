.notice { margin-top: 16rpx; }.textarea { width: 100%; height: 150rpx; box-sizing: border-box; }.fields { display: grid; grid-template-columns: 1fr 1fr; gap: 15rpx; }.save { margin-top: 24rpx; }.error { color: #a34a2a; margin-top: 16rpx; font-size: 23rpx; }.link { color: #236e53; font-size: 24rpx; }.empty { color: #6e8178; padding: 25rpx 0; }.slot { background: #fff5de; padding: 16rpx; border-radius: 14rpx; margin-top: 12rpx; font-size: 24rpx; }.draft { padding: 18rpx 0; border-bottom: 1rpx solid #edf0ed; }.remove { color: #a34a2a; font-size: 23rpx; }
