.publish-page { padding-bottom: 180rpx; }
.intro { margin-top: 8rpx; }
.starter { padding-bottom: 18rpx; }
.start-option { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 18rpx; border-radius: 22rpx; margin-top: 18rpx; }
.start-option.experience { background: #e8f3ea; }
.start-option.errand { background: #fff2d6; }
.start-option .start-icon { width: 76rpx; height: 76rpx; flex-shrink: 0; border-radius: 22rpx; display: flex; justify-content: center; align-items: center; background: #fff; color: #236e53; font-size: 34rpx; font-weight: 700; }
.start-copy { flex: 1; min-width: 0; }
.start-title { font-size: 30rpx; font-weight: 700; }
.start-option > text { color: #236e53; font-size: 38rpx; }
.hint-line { color: #82948a; font-size: 22rpx; margin-top: 18rpx; }
.empty { padding: 28rpx 0; color: #8a9a90; }
.mine-row { display: flex; align-items: center; gap: 18rpx; border-top: 1rpx solid #e9efe9; padding: 20rpx 0; }
.mine-row:first-of-type { margin-top: 16rpx; }
.mine-main { flex: 1; min-width: 0; }
.mine-title { font-size: 27rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.edit-link,.template-link,.back-link { color: #236e53; }
.edit-link { font-size: 24rpx; padding: 10rpx; }
.delete-link { color: #a34a2a; font-size: 23rpx; padding: 10rpx 0; }
.form-heading { margin: 3rpx 0 14rpx; }
.form-heading .title { margin-top: 8rpx; font-size: 39rpx; }
.whole-template { display: inline-block; color: #236e53; background: #e8f3ea; border-radius: 999rpx; padding: 10rpx 20rpx; font-size: 23rpx; }
.back-link { display: inline-flex; align-items: center; min-height: 76rpx; box-sizing: border-box; padding: 13rpx 22rpx; margin: 4rpx 0 15rpx; border: 2rpx solid #a8c7b2; border-radius: 18rpx; background: #e8f3ea; font-size: 27rpx; font-weight: 700; color: #236e53; }
.category-option { background: #f0f6ee; }
.category-option:nth-child(3) { background: #fff3db; }
.category-option:nth-child(4) { background: #e9f2f8; }
.category-option:nth-child(5) { background: #f6edf4; }
.request-save { width: 100%; margin-top: 24rpx; }
.price-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 12rpx 0; border-bottom: 1rpx solid #e7eee8; font-size: 24rpx; }
.price-row .input { width: 190rpx; flex-shrink: 0; }
.form-progress { display: flex; justify-content: center; gap: 16rpx; color: #7b9184; font-size: 22rpx; padding: 12rpx; }
.form-progress .on { color: #236e53; font-weight: 700; }
.local-note { margin-top: 12rpx; }
.form-card { margin-top: 18rpx; }
.textarea { box-sizing: border-box; width: 100%; height: 180rpx; line-height: 1.5; }
.field-heading { align-items: baseline; margin-top: 8rpx; }
.field-heading .field-label { margin-bottom: 10rpx; }
.template-link { font-size: 23rpx; padding: 8rpx 0; }
.resume-row { display: flex; align-items: center; gap: 8rpx; margin-top: 12rpx; }
.resume-number { display: flex; flex-shrink: 0; width: 36rpx; height: 36rpx; align-items: center; justify-content: center; border-radius: 50%; background: #e8f3ea; color: #236e53; font-size: 20rpx; }
.resume-input { flex: 1; min-width: 0; }
.remove-mini { color: #a34a2a; padding: 13rpx; font-size: 31rpx; }
.add-line { border: 1rpx dashed #a5c8af; border-radius: 17rpx; color: #236e53; background: #f3faf4; text-align: center; padding: 18rpx; font-size: 24rpx; margin-top: 18rpx; }
.choice-row { display: flex; gap: 10rpx; margin: 10rpx 0; }
.choice-row.wrap { flex-wrap: wrap; }
.choice-row text { flex: 1; border-radius: 15rpx; border: 1rpx solid #e1e9e2; background: #f7f8f5; text-align: center; padding: 17rpx 8rpx; font-size: 22rpx; white-space: nowrap; }
.choice-row.wrap text { flex: none; }
.choice-row text.chosen { border-color: #8ebaa1; color: #236e53; background: #e8f3ea; font-weight: 700; }
.fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.fields .input { min-width: 0; }
.location-tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.location-tags text { padding: 10rpx 17rpx; background: #e8f3ea; border-radius: 999rpx; color: #236e53; font-size: 22rpx; }
.location-add .input { flex: 1; min-width: 0; }
.add-place { color: #236e53; padding: 14rpx 0; font-size: 23rpx; }
.window-row { display: flex; justify-content: space-between; gap: 16rpx; background: #f7f8f5; border-radius: 14rpx; padding: 18rpx; margin-top: 9rpx; font-size: 22rpx; }
.window-row text:last-child { color: #a34a2a; }
.time-entry { margin-top: 10rpx; }
.capacity-row .input { width: 130rpx; }
.save-actions { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 25rpx; }
.save-actions .btn { flex: 1; min-width: 180rpx; font-size: 23rpx; padding: 18rpx 8rpx; }
.save-actions .btn:last-child { flex-basis: 100%; }
.error { margin-top: 16rpx; background: #fff1e8; color: #a34a2a; padding: 18rpx; border-radius: 14rpx; font-size: 23rpx; }
.overlay { position: fixed; inset: 0; z-index: 20; background: rgba(11,31,23,.4); display: flex; align-items: flex-end; }
.sheet { box-sizing: border-box; width: 100%; max-height: 90vh; overflow-y: auto; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 30rpx 28rpx calc(35rpx + env(safe-area-inset-bottom)); }
.close { color: #6e8178; font-size: 48rpx; padding: 0 10rpx; }
.template-item { border: 1rpx solid #e5eee6; border-radius: 18rpx; padding: 20rpx; margin-top: 14rpx; }
.template-item .row { color: #236e53; }
.template-name { color: #172c26; font-size: 27rpx; font-weight: 700; }
.template-item .small { margin-top: 6rpx; line-height: 1.5; }
.sheet-button { width: 100%; margin-top: 20rpx; }
.date-picker { margin: 16rpx 0 10rpx; }
.range-help { color: #6e8178; font-size: 21rpx; margin: 9rpx 0 14rpx; }
.time-grid-scroll { height: 48vh; max-height: 650rpx; border: 1rpx solid #e4ebe4; border-radius: 17rpx; }
.time-hour { display: flex; min-height: 75rpx; border-bottom: 1rpx solid #e7ece7; }
.time-hour-label { width: 87rpx; flex-shrink: 0; box-sizing: border-box; padding: 12rpx 6rpx; color: #87978b; font-size: 21rpx; }
.time-cells { display: flex; flex: 1; gap: 4rpx; padding: 4rpx; }
.time-cell { position: relative; display: flex; align-items: center; justify-content: center; min-width: 0; border: 2rpx solid #fff; border-radius: 9rpx; background: #f1f3f1; font-size: 20rpx; overflow: hidden; }
.time-cell.open { background: #fff2d3; }
.time-cell.busy { color: #9ca8a0; background: #e8ece8; }
.time-cell.selected { color: #236e53; background: #dcefe1; border-color: #6fa780; }
.corner { position: absolute; color: #21744e; font-size: 28rpx; line-height: 1; }
.corner.start { left: 1rpx; top: 1rpx; }
.corner.end { right: 1rpx; bottom: 1rpx; }
.selected-range { color: #236e53; font-size: 23rpx; padding: 18rpx 0 0; min-height: 30rpx; }

.mode-choice text { white-space: normal; min-height: 54rpx; display: flex; align-items: center; justify-content: center; }
.chooser-overlay { z-index: 80; }
.chooser-sheet { padding-bottom: calc(58rpx + env(safe-area-inset-bottom)); }
.chooser-pair { display: flex; gap: 16rpx; margin-top: 26rpx; }
.chooser-tile { width: 50%; min-height: 210rpx; box-sizing: border-box; border-radius: 22rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 10rpx; padding: 20rpx 10rpx; text-align: center; }
.chooser-tile.sell { background: #e8f3ea; }
.chooser-tile.buy { background: #fff2d6; }
.chooser-icon { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; background: #fff; border-radius: 18rpx; font-size: 34rpx; color: #236e53; }
.chooser-title { font-size: 29rpx; font-weight: 700; }
