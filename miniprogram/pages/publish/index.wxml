<view class="page publish-page" data-b="B401">
  <dev-badge wx:if="{{developerMode}}" code="B401" />
  <view wx:if="{{stage === 'start'}}">
    <view class="title">发布</view>
    <view class="subtitle intro">你可以出售自己的时间，也可以发布想购买的服务。</view>
    <view wx:if="{{!chooserOpen}}" class="card starter" data-b="B406"><dev-badge wx:if="{{developerMode}}" code="B406" />
      <view class="section-title">选择发布方向</view>
      <view class="start-option experience" data-stage="sell" data-z="Z406-1" bindtap="start">
        <view class="start-icon">售</view><view class="start-copy"><view class="start-title">时间售卖</view><view class="subtitle">发布可提供的服务与时间</view></view><text>›</text>
      </view>
      <view class="start-option errand" data-stage="buy" data-z="Z406-2" bindtap="start">
        <view class="start-icon">求</view><view class="start-copy"><view class="start-title">时间求购</view><view class="subtitle">说出需要的帮助和期望时间</view></view><text>›</text>
      </view>
      <view class="hint-line">当前是本机体验，其他用户尚看不到你的发布。</view>
    </view>
    <view class="card my-list" data-b="B405"><dev-badge wx:if="{{developerMode}}" code="B405" />
      <view class="section-title">我的售卖</view>
      <view wx:if="{{!listings.length}}" class="empty">还没有草稿或本机发布。</view>
      <view wx:for="{{listings}}" wx:key="id" class="mine-row">
        <view class="mine-main" data-id="{{item.id}}" data-z="Z405-1" bindtap="previewFromList"><view class="mine-title">{{item.title}}</view><view class="small muted">{{item.kindLabel}} · {{item.statusLabel}} · ¥{{item.price || '—'}}</view></view>
        <text class="edit-link" data-id="{{item.id}}" data-z="Z405-2" bindtap="editFromList">编辑</text><text class="delete-link" data-id="{{item.id}}" data-z="Z405-3" bindtap="removeFromList">删除</text>
      </view>
    </view>
    <view class="card my-list" data-b="B418"><dev-badge wx:if="{{developerMode}}" code="B418" /><view class="section-title">我的求购</view><view wx:if="{{!requests.length}}" class="empty">还没有求购记录。</view><view wx:for="{{requests}}" wx:key="id" class="mine-row"><view class="mine-main"><view class="mine-title">{{item.title}}</view><view class="small muted">{{item.category}} · {{item.subcategory}} · 本机记录</view></view></view></view>
  </view>
  <view wx:elif="{{stage === 'sell'}}" data-b="B416" class="form-flow"><dev-badge wx:if="{{developerMode}}" code="B416" /><view class="back-link" data-z="Z416-1" bindtap="backStart">← 返回发布首页</view><view class="title">时间售卖</view><view class="subtitle intro">先选大类，下一步再选具体类别。</view><view class="card starter" data-b="B423"><dev-badge wx:if="{{developerMode}}" code="B423" /><view class="section-title">选择售卖大类</view><view wx:for="{{marketCategories}}" wx:key="name" class="start-option category-option" data-category="{{item.name}}" data-z="Z423-1" bindtap="startCategory"><view class="start-icon">{{item.icon}}</view><view class="start-copy"><view class="start-title">{{item.name}}</view><view class="subtitle">{{item.description}}</view></view><text>›</text></view></view></view>
  <view wx:elif="{{stage === 'buy'}}" data-b="B417" class="form-flow"><dev-badge wx:if="{{developerMode}}" code="B417" /><view class="back-link" data-z="Z417-1" bindtap="backStart">← 返回发布首页</view><view class="title">时间求购</view><view class="notice local-note">目前仅保存在本机，尚未进入公共大厅。</view><view class="card form-card" data-b="B424"><dev-badge wx:if="{{developerMode}}" code="B424" /><view class="section-title">我想找人帮忙</view><text class="field-label">求购标题</text><input class="input" placeholder="例如：周末找钢琴老师" value="{{requestForm.title}}" data-field="title" data-z="Z424-1" bindinput="requestField" maxlength="40" /><text class="field-label">大类</text><picker mode="selector" range="{{marketCategories}}" range-key="name" value="{{requestCategoryIndex}}" data-z="Z424-2" bindchange="requestCategory"><view class="picker">{{requestForm.category}} ▾</view></picker><text class="field-label">具体类别</text><picker mode="selector" range="{{requestSubcategories}}" value="{{requestSubcategoryIndex}}" data-z="Z424-3" bindchange="requestSubcategory"><view class="picker">{{requestForm.subcategory}} ▾</view></picker><text class="field-label">具体需求</text><textarea class="input textarea" placeholder="说明想得到什么帮助、地点和其他要求" value="{{requestForm.detail}}" data-field="detail" data-z="Z424-4" bindinput="requestField" maxlength="500" /><view class="fields"><view><text class="field-label">希望日期</text><picker mode="date" value="{{requestForm.date}}" data-field="date" data-z="Z424-5" bindchange="requestField"><view class="picker">{{requestForm.date}}</view></picker></view><view><text class="field-label">预算（元，可留空）</text><input class="input" type="digit" value="{{requestForm.budget}}" data-field="budget" data-z="Z424-6" bindinput="requestField" /></view></view></view><view wx:if="{{error}}" class="error" data-b="B420"><dev-badge wx:if="{{developerMode}}" code="B420" />{{error}}</view><button class="btn request-save" data-z="Z417-8" bindtap="saveRequest">保存求购到本机</button></view>
  <view wx:else data-b="B403" class="form-flow">
    <view class="row form-heading"><view><view class="back-link" data-z="Z403-1" bindtap="back">← 返回{{editingId ? '发布首页' : '售卖大类'}}</view><view class="title">发布{{form.marketCategory}}</view></view><dev-badge wx:if="{{developerMode}}" code="B403" /></view>
    <view class="whole-template" data-target="whole" data-z="Z403-18" bindtap="openTemplates">从整套模板开始 ›</view>
    <view class="form-progress"><text class="on">内容</text><text>›</text><text>方式与地点</text><text>›</text><text>时间与价格</text></view>
    <view class="notice local-note">目前只能在这台设备体验发布与详情，其他用户暂时看不到。</view>

    <view class="card form-card" data-b="B421"><dev-badge wx:if="{{developerMode}}" code="B421" />
      <view class="section-title">01 · 服务内容</view>
      <text class="field-label">服务名称</text>
      <input class="input" placeholder="{{kind === 'experience' ? '例如：网约车入行经验交流' : '例如：帮忙遛狗'}}" value="{{form.title}}" data-field="title" data-z="Z421-1" bindinput="field" maxlength="40" />
      <view><text class="field-label">{{form.marketCategory}} · 具体类别</text><picker mode="selector" range="{{subcategories}}" value="{{categoryIndex}}" data-z="Z421-2" bindchange="category"><view class="picker">{{form.category}} ▾</view></picker></view>
      <view class="row field-heading"><text class="field-label">我能提供什么</text><text class="template-link" data-target="offer" data-z="Z421-3" bindtap="openTemplates">选择模板 ›</text></view>
      <textarea class="input textarea" placeholder="说明具体服务内容、适合谁，以及对方能得到什么" value="{{form.offer}}" data-field="offer" data-z="Z421-4" bindinput="field" maxlength="500" />
      <view class="row field-heading"><text class="field-label">履历介绍</text><text class="template-link" data-target="resume" data-z="Z421-5" bindtap="openTemplates">选择模板 ›</text></view>
      <view class="subtitle">按需填写真实经历；没有合适内容可以留空。</view>
      <view wx:for="{{form.resume}}" wx:key="index" class="resume-row" data-b="B412"><dev-badge wx:if="{{developerMode}}" code="B412" />
        <text class="resume-number">{{index + 1}}</text>
        <input class="input resume-input" placeholder="第{{index + 1}}条相关经历" value="{{item}}" data-index="{{index}}" data-z="Z412-1" bindinput="resumeInput" maxlength="120" />
        <text class="remove-mini" data-index="{{index}}" data-z="Z412-2" bindtap="removeResume">×</text>
      </view>
      <view class="add-line" data-z="Z421-6" bindtap="addResume">＋ 增加一条履历</view>
    </view>

    <view class="card form-card" data-b="B422"><dev-badge wx:if="{{developerMode}}" code="B422" />
      <view class="section-title">02 · 方式与地点</view>
      <view wx:if="{{kind === 'experience'}}">
        <text class="field-label">交流方式</text>
        <view class="subtitle">三选一；选择组合时分别填写线上和线下价格。</view><view class="choice-row mode-choice"><text class="{{hasOnline && !hasOffline ? 'chosen' : ''}}" data-value="线上交流" data-z="Z422-1" bindtap="chooseMode">线上交流</text><text class="{{hasOffline && !hasOnline ? 'chosen' : ''}}" data-value="线下交流" data-z="Z422-2" bindtap="chooseMode">线下交流</text><text class="{{hasOnline && hasOffline ? 'chosen' : ''}}" data-value="线上＋线下" data-z="Z422-3" bindtap="chooseMode">线上＋线下</text></view>
        <view wx:if="{{hasOffline}}" data-b="B413"><dev-badge wx:if="{{developerMode}}" code="B413" />
          <text class="field-label">见面场地</text>
          <view class="choice-row wrap"><text class="{{form.venue === '公共场所' ? 'chosen' : ''}}" data-field="venue" data-value="公共场所" data-z="Z413-1" bindtap="choose">公共场所</text><text class="{{form.venue === '我提供场地' ? 'chosen' : ''}}" data-field="venue" data-value="我提供场地" data-z="Z413-2" bindtap="choose">我提供场地</text><text class="{{form.venue === '双方协商' ? 'chosen' : ''}}" data-field="venue" data-value="双方协商" data-z="Z413-3" bindtap="choose">双方协商</text><text class="{{form.venue === '指定地点' ? 'chosen' : ''}}" data-field="venue" data-value="指定地点" data-z="Z413-4" bindtap="choose">指定地点</text></view>
        </view>
        <text class="field-label">预约形式</text>
        <view class="choice-row"><text class="{{hasOne ? 'chosen' : ''}}" data-field="meetings" data-value="一对一" data-z="Z422-4" bindtap="toggleChoice">一对一</text><text class="{{hasGroup ? 'chosen' : ''}}" data-field="meetings" data-value="开团" data-z="Z422-5" bindtap="toggleChoice">开团</text></view>
        <view wx:if="{{hasGroup}}" data-b="B414"><dev-badge wx:if="{{developerMode}}" code="B414" /><view class="fields"><view><text class="field-label">几人成团（至少 3 人）</text><input class="input" type="number" value="{{form.minPeople}}" data-field="minPeople" data-z="Z414-1" bindinput="field" /></view><view><text class="field-label">最多人数</text><input class="input" type="number" value="{{form.maxPeople}}" data-field="maxPeople" data-z="Z414-2" bindinput="field" /></view></view><view class="small muted">开团按每人计价；达到成团人数才生效。真实报名与交易尚未开放。</view></view>
      </view>
      <view wx:else>
        <text class="field-label">服务范围</text>
        <view class="choice-row"><text class="{{form.scope === '指定地点' ? 'chosen' : ''}}" data-field="scope" data-value="指定地点" data-z="Z422-6" bindtap="choose">指定地点</text><text class="{{form.scope === '全城' ? 'chosen' : ''}}" data-field="scope" data-value="全城" data-z="Z422-7" bindtap="choose">全城</text></view>
        <view wx:if="{{form.scope === '全城'}}"><text class="field-label">服务城市</text><input class="input" placeholder="例如：杭州；请确认实际能覆盖" value="{{form.city}}" data-field="city" data-z="Z422-8" bindinput="field" maxlength="30" /></view>
      </view>
      <view wx:if="{{kind === 'errand' && form.scope === '指定地点' || kind === 'experience' && hasOffline && form.venue === '指定地点'}}" data-b="B415"><dev-badge wx:if="{{developerMode}}" code="B415" /><text class="field-label">指定地点（可添加多个小区或地点）</text>
        <view class="location-tags"><text wx:for="{{form.locations}}" wx:key="*this" data-index="{{index}}" data-z="Z415-1" bindtap="removeLocation">{{item}} ×</text></view>
        <view class="row location-add"><input class="input" placeholder="输入地点或小区名称" value="{{locationInput}}" data-z="Z415-2" bindinput="locationInput" maxlength="50" /><text class="add-place" data-z="Z415-3" bindtap="addLocation">＋ 添加</text></view>
      </view>
    </view>

    <view class="card form-card" data-b="B404"><dev-badge wx:if="{{developerMode}}" code="B404" />
      <view class="section-title">03 · 时间与价格</view>
      <view wx:if="{{kind === 'errand'}}"><text class="field-label">服务时间</text><view class="choice-row"><text class="{{form.timeMode === 'exact' ? 'chosen' : ''}}" data-field="timeMode" data-value="exact" data-z="Z404-1" bindtap="choose">约定具体时段</text><text class="{{form.timeMode === 'flexible' ? 'chosen' : ''}}" data-field="timeMode" data-value="flexible" data-z="Z404-2" bindtap="choose">限期内完成</text></view><view class="small muted">{{form.timeMode === 'exact' ? '例如 8:00—9:00，按这个时间提供服务。' : '例如 8:00—17:00，在区间内完成。'}}</view></view>
      <text class="field-label">{{kind === 'experience' ? '交流时间' : '选择可服务时间'}}</text>
      <view wx:for="{{form.windows}}" wx:key="id" class="window-row"><text>{{item.date}}　{{item.start}}—{{item.end}}</text><text data-index="{{index}}" data-z="Z404-3" bindtap="removeWindow">移除</text></view>
      <view class="add-line time-entry" data-z="Z404-4" bindtap="openTimePicker">＋ 在这里选择时间块</view>
      <view wx:if="{{kind === 'errand'}}"><text class="field-label">这个时间段最多接几单</text><view class="row capacity-row"><input class="input" type="number" value="{{form.capacity}}" data-field="capacity" data-z="Z404-5" bindinput="field" /><text>单</text></view><view class="small muted">多个指定地点共用此上限；每段时间单独计算。</view></view>
      <view wx:if="{{kind === 'errand'}}"><text class="field-label">收费方式</text><view class="choice-row"><text class="{{form.priceUnit === '按次' ? 'chosen' : ''}}" data-field="priceUnit" data-value="按次" data-z="Z404-8" bindtap="choose">按次</text><text class="{{form.priceUnit === '按小时' ? 'chosen' : ''}}" data-field="priceUnit" data-value="按小时" data-z="Z404-9" bindtap="choose">按小时</text></view></view>
      <view wx:if="{{kind === 'experience'}}" data-b="B419"><dev-badge wx:if="{{developerMode}}" code="B419" /><view class="section-title">按服务方式定价</view><view wx:for="{{priceRows}}" wx:key="key" class="price-row"><text>{{item.label}}</text><input class="input" type="digit" placeholder="元" value="{{item.value}}" data-key="{{item.key}}" data-z="Z419-1" bindinput="priceField" /></view></view><view wx:else><text class="field-label">价格（元）</text><input class="input" type="digit" placeholder="99" value="{{form.price}}" data-field="price" data-z="Z404-6" bindinput="field" /></view><text class="field-label">参考时长（分钟）</text><input class="input" type="number" value="{{form.duration}}" data-field="duration" data-z="Z404-7" bindinput="field" />
      <view class="small muted">目前只展示价格，不会收款或生成真实订单。</view>
    </view>
    <view wx:if="{{error}}" class="error" data-b="B402"><dev-badge wx:if="{{developerMode}}" code="B402" />{{error}}</view>
    <view class="save-actions"><button class="btn ghost" data-z="Z403-15" bindtap="openSaveTemplate">保存为模板</button><button class="btn secondary" data-z="Z403-16" bindtap="saveDraft">存草稿</button><button class="btn" data-z="Z403-17" bindtap="publish">本机发布并查看</button></view>
  </view>
</view>

<view wx:if="{{templatePanel}}" class="overlay" data-b="B407"><view class="sheet template-sheet"><dev-badge wx:if="{{developerMode}}" code="B407" /><view class="row"><view class="section-title">{{templatePanel === 'offer' ? '选择服务内容模板' : templatePanel === 'resume' ? '选择履历模板' : '选择整套模板'}}</view><text class="close" data-z="Z407-1" bindtap="closeTemplates">×</text></view><view class="subtitle">模板是填写示例，请按自己的真实情况修改。</view>
  <block wx:for="{{templates}}" wx:key="id"><view wx:if="{{templatePanel !== 'whole' || item.marketCategory === form.marketCategory || !item.marketCategory && item.kind === kind}}" class="template-item" data-id="{{item.id}}" data-z="Z407-2" bindtap="applyTemplate"><view class="row"><text class="template-name">{{item.name}}</text><text>选用 ›</text></view><view class="small muted">{{templatePanel === 'resume' ? item.resume[0] : item.offer}}</view></view></block>
  <view wx:if="{{ownTemplates.length}}" class="field-label">我保存的模板</view><block wx:for="{{ownTemplates}}" wx:key="id"><view wx:if="{{templatePanel !== 'whole' || item.marketCategory === form.marketCategory || !item.marketCategory && item.kind === kind}}" class="template-item" data-id="{{item.id}}" data-z="Z407-2" bindtap="applyTemplate"><view class="row"><text class="template-name">{{item.name}}</text><text>选用 ›</text></view><view class="small muted">{{templatePanel === 'resume' ? item.resume[0] : item.offer}}</view></view></block>
</view></view>

<view wx:if="{{templateNameOpen}}" class="overlay" data-b="B408"><view class="sheet"><dev-badge wx:if="{{developerMode}}" code="B408" /><view class="row"><view class="section-title">保存为模板</view><text class="close" data-z="Z408-1" bindtap="closeSaveTemplate">×</text></view><view class="subtitle">保存服务内容和履历，下次发布时重新选择时间。</view><text class="field-label">模板名称</text><input class="input" placeholder="例如：我的网约车经验" value="{{templateName}}" data-z="Z408-2" bindinput="templateNameInput" maxlength="30" /><button class="btn sheet-button" data-z="Z408-3" bindtap="saveTemplate">保存模板</button></view></view>

<view wx:if="{{timePicker}}" class="overlay" data-b="B409"><view class="sheet time-sheet"><dev-badge wx:if="{{developerMode}}" code="B409" /><view class="row"><view><view class="section-title">选择时间块</view><view class="small muted">共用时间表；已安排时段不能选择</view></view><text class="close" data-z="Z409-1" bindtap="closeTimePicker">×</text></view>
  <picker mode="date" value="{{pickerDate}}" start="{{todayKey}}" data-z="Z409-2" bindchange="pickerDateChange"><view class="picker date-picker">{{pickerDate}}　选择日期 ▾</view></picker>
  <view class="range-help">轻点连续选格；长按 2 秒设起点，再长按一格设终点。</view>
  <scroll-view scroll-y class="time-grid-scroll"><view wx:for="{{pickerRows}}" wx:key="hour" class="time-hour"><text class="time-hour-label">{{item.label}}</text><view class="time-cells"><view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="id" class="time-cell {{cell.busy ? 'busy' : ''}} {{cell.selected ? 'selected' : ''}} {{cell.type === 'open' ? 'open' : ''}}" style="flex:{{cell.flex}}" data-index="{{cell.index}}" data-z="Z409-3" bindtap="selectPickerCell" bindtouchstart="holdStart" bindtouchmove="holdEnd" bindtouchend="holdEnd" bindtouchcancel="holdEnd"><text wx:if="{{cell.index === rangeStart}}" class="corner start">◤</text><text wx:if="{{cell.index === rangeEnd}}" class="corner end">◢</text><text>{{cell.busy ? '已占用' : cell.start}}</text></view></view></view></scroll-view>
  <view class="selected-range">{{pickerSummary || '尚未选择时间'}}</view><button class="btn sheet-button" data-z="Z409-4" bindtap="addWindow">加入这段时间</button>
</view></view>

<view wx:if="{{chooserOpen}}" class="overlay chooser-overlay" data-b="B425" data-z="Z425-4" catchtap="closeChooser"><view class="sheet chooser-sheet" data-z="Z425-5" catchtap="noop"><view class="row"><view><view class="section-title">选择发布方向</view><view class="subtitle">你的时间可以出售，也可以向别人求购帮助。</view></view><dev-badge wx:if="{{developerMode}}" code="B425" /><text class="close" data-z="Z425-1" catchtap="closeChooser">×</text></view><view class="chooser-pair"><view class="chooser-tile sell" data-stage="sell" data-z="Z425-2" catchtap="start"><text class="chooser-icon">售</text><text class="chooser-title">时间售卖</text><text class="small muted">分享经验或提供服务</text></view><view class="chooser-tile buy" data-stage="buy" data-z="Z425-3" catchtap="start"><text class="chooser-icon">求</text><text class="chooser-title">时间求购</text><text class="small muted">发布需求寻找帮助</text></view></view></view></view>
